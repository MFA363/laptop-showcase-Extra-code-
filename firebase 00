// ─── 3. LIVE DATA ACTIONS ───────────────────────────────────────────────────
export async function fetchAllLaptops() {
  const snapshot = await getDocs(collection(db, "laptops"));
  return snapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));
}

export async function fetchLaptopById(id: string) {
  const ref = doc(db, "laptops", id);
  const snap = await getDoc(ref);
  return snap.exists() ? { id: snap.id, ...snap.data() } : null;
}

export async function addLaptop(laptop: any) {
  return addDoc(collection(db, "laptops"), laptop);
}

export async function updateLaptop(id: string, data: any) {
  return updateDoc(doc(db, "laptops", id), data);
}

export async function deleteLaptop(id: string) {
  return deleteDoc(doc(db, "laptops", id));
}

export async function fetchLaptopsByCategory(category: string) {
  const q = query(
    collection(db, "laptops"),
    where("category", "==", category)
  );
  const snapshot = await getDocs(q);
  return snapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));
}

export async function fetchFeaturedLaptops() {
  const q = query(
    collection(db, "laptops"),
    where("featured", "==", true)
  );
  const snapshot = await getDocs(q);
  return snapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));
}

