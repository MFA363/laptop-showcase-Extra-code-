export async function seedFirestore() {
  const { LAPTOPS } = await import("./laptops");
  for (const laptop of LAPTOPS) {
    const { id, ...data } = laptop;
    await addDoc(collection(db, "laptops"), data);
  }
  console.log("Success! Firestore populated with", LAPTOPS.length, "laptops.");
}
